<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      THE PARENT (2026-10-28), as every plugin's: it pins the contract, the toolkit and JavaFX together, sets
      Java 25 and the compiler JitPack needs, flattens the published pom keeping <properties>, and copies
      CHANGELOG.md and icon.png into the jar. Its version is a pin like any other (doc 43): the parent's -SNAPSHOT
      on main, read from the umbrella's sibling checkout; its released tag on a tag, resolved through JitPack.
    -->
    <parent>
        <groupId>com.github.BotMakerDev</groupId>
        <artifactId>botmaker-plugin-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../botmaker-plugin-parent/pom.xml</relativePath>
    </parent>

    <!--
      groupId is com.github.BotMakerDev for the same reason as every other published module: JitPack serves
      this repo as com.github.BotMakerDev:botmaker-plugin-basics:<tag> whatever this pom says, so matching it
      here makes the reactor GAV identical to the published GAV. The version is real: -SNAPSHOT on main, the
      release version on a tag; only the release moves it (umbrella docs/refactor/43-real-versions.md).
    -->
    <groupId>com.github.BotMakerDev</groupId>
    <artifactId>botmaker-plugin-basics</artifactId>
    <version>0.7.1-SNAPSHOT</version>

    <!-- What Studio shows for this plugin: a plugin's name is its pom's <name> (2026-10-27). -->
    <name>BotMaker Basics</name>
    <description>
        Plugin #2: the nine JDK value types a project's parameters are made of, the Settings a running bot
        reads them through, and the project store both of those are written into — usable by any other
        plugin as an ordinary Maven dependency.
    </description>

    <!--
      THIS IS A PLUGIN, not a platform module, and the distinction decides every scope below. Studio does
      not have this artifact; a project that wants it resolves it, and PluginLoader puts it on that
      project's own classloader beside every other plugin. The contract and JavaFX are the host's and are
      therefore `provided`; everything else here travels.

      IT IS ALSO A PLUGIN OTHER PLUGINS DEPEND ON, which is new in this project and has a price stated once
      here so it is not rediscovered: botmaker-sdk will declare this module at `compile` scope (phase 2 of
      ~/.claude/plans/settings-becomes-a-plugin.md), so its compiled classes are pinned to whatever is
      published here. Nobody can rewrite a .class file, so a member removed here breaks the SDK until
      the SDK is released against it (CLAUDE.md: it breaks like com.botmaker.sdk.api, released together). The trap that goes with it is Maven's nearest-wins mediation:
      nothing may declare this module DIRECTLY beside a plugin that already brings it, or the direct entry
      wins and a bot runs a version its plugin was never built against. That is the landmine
      MavenService.TOOLKIT_FALLBACK_VERSION was, and why that constant is deleted.
    -->
    <properties>
        <!-- The plugin class this jar is: the host reads it off the pom Maven copies into the jar, and this
             pom's groupId:artifactId is the plugin's identity. Literal, and kept by the parent's flatten. -->
        <botmaker.plugin>com.botmaker.plugin.basics.BasicsPlugin</botmaker.plugin>
        <junit.version>5.10.2</junit.version>
    </properties>

    <repositories>
        <!-- JitPack serves the parent above on a tag, and the contract and toolkit it pins. -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          The contract, `provided`: this module implements StudioPlugin, and the host already has these
          classes. A second copy inside this jar is the one mistake that produces a ClassCastException
          between two classes with identical names — PluginLoader is parent-first for
          com.botmaker.plugin.api.** precisely so there is exactly one. Its version is the parent's.
        -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-studio-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          The widgets, `compile`: resolved onto THIS plugin's classloader, so this plugin's toolkit version
          is its own and no other plugin's. Never `provided` (the host has none) and never `optional`
          (optional means not transitive, which is the same bug this project has shipped three times).
        -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-toolkit</artifactId>
        </dependency>

        <!--
          JavaFX, `provided` for the same reason as the contract: a slot editor draws into the host's scene
          graph, and PluginLoader is parent-first for `javafx.` so the host supplies the one copy. It is
          here because a subclass of the toolkit's AbstractStudioPlugin resolves signatures that name
          javafx.scene.Node; a bot never sees it, because `provided` is not transitive.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson stood here for the store (PluginData, Settings) until 2026-09-28, when the store went. -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      No <build>: the parent pins the compiler (3.11.0) and surefire, and runs flatten 1.4.1 keeping <properties>
      and <repositories>, which this pom set itself until 2026-10-28. Why each is pinned is in the parent and in
      the umbrella CLAUDE.md § JitPack.
    -->
</project>
